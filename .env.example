PORT=8000
HOST=0.0.0.0
# Set this to your computer's Wi-Fi/LAN IPv4 address for phone access.
API_BIND_IP=127.0.0.1
UPLOAD_DIR=./uploads
MAX_PHOTOS=20
MAX_AUDIO=10
MAX_PHOTO_BYTES=15728640
MAX_AUDIO_BYTES=31457280
MAX_REQUEST_BYTES=209715200
MAX_METADATA_BYTES=131072
UPLOAD_IP_LIMIT=30
UPLOAD_USER_LIMIT=60
DATABASE_URL=postgresql://tap:replace-with-local-password@localhost:5432/tap_renovation?schema=public
TEST_DATABASE_URL=postgresql://tap:replace-with-local-password@localhost:5433/tap_renovation_test?schema=public
POSTGRES_USER=tap
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=tap_renovation
# Set a unique random value of at least 32 bytes before starting the server.
JWT_SECRET=
JWT_ISSUER=nwash-api
JWT_AUDIENCE=nwash-mobile
TRUST_PROXY_HOPS=0
# Optional development seed only. Leave blank unless running npm run seed:dev.
SEED_FULL_NAME=
SEED_EMAIL=
SEED_PASSWORD=
